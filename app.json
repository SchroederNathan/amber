{
  "expo": {
    "name": "amber",
    "slug": "amber",
    "scheme": "amber",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#fafafa",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/app-icon/amber.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Amber uses your camera so you can capture things you want to save for later.",
        "NSMicrophoneUsageDescription": "Amber needs access to your Microphone to record audio for video recordings.",
        "NSPhotoLibraryUsageDescription": "Amber lets you save photos and screenshots from your library into your hub.",
        "NSPhotoLibraryAddUsageDescription": "Amber can save images back to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.schroedernathan.amber"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/app-icon/android/foreground.png",
        "backgroundImage": "./assets/app-icon/android/background.png",
        "monochromeImage": "./assets/app-icon/android/monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/app-icon/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ExposureTrial-0.otf",
            "./assets/fonts/Satoshi-Regular.otf",
            "./assets/fonts/Satoshi-Medium.otf",
            "./assets/fonts/Satoshi-Bold.otf"
          ]
        }
      ],
      "expo-image",
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/light.png",
          "backgroundColor": "#fafafa",
          "dark": {
            "image": "./assets/splash/dark.png",
            "backgroundColor": "#0a0a0a"
          },
          "imageWidth": 200
        }
      ],
      "@clerk/expo",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Amber uses Face ID to keep your saved content private."
        }
      ],
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "Amber adds events to your calendar from things you've saved."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Amber lets you tidy your photo library \u2014 keep, delete, or save photos into your hub.",
          "savePhotosPermission": "Amber can save images back to your photo library."
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsImageWithMaxCount": 10,
              "supportsWebUrlWithMaxCount": 1,
              "supportsText": true
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "image/*",
              "text/*"
            ],
            "multipleShareMimeTypes": [
              "image/*"
            ]
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Amber uses Face ID to keep your saved content private."
        }
      ],
      "expo-app-intents"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "967a8121-92b8-4eb9-a208-9addf1220534"
      }
    },
    "owner": "exponathan"
  }
}
