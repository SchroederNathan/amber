+/**
+ * Copies the colors of [night] (the same layout rendered for the dark theme)
+ * into this tree as day/night colors. Widget content is only rendered on
+ * update, so fixed colors would keep the theme of the last update; day/night
+ * colors let the launcher follow the system theme on its own. Parts whose
+ * structure differs between the two renders keep this tree's colors.
+ */
+internal fun Emittable.withNightColors(night: Emittable): Emittable {
+  mergeNightColors(this, night)
+  return this
+}
+
+private fun mergeNightColors(day: Emittable, night: Emittable) {
+  if (day::class != night::class) return
+  day.modifier = day.modifier.withNightColors(night.modifier)
+  if (day is EmittableWithText && night is EmittableWithText) {
+    day.style = day.style?.let { style -> style.copy(color = dayNight(style.color, night.style?.color)) }
+  }
+  if (day is EmittableImage && night is EmittableImage) {
+    val dayTint = (day.colorFilterParams as? TintColorFilterParams)?.colorProvider
+    val nightTint = (night.colorFilterParams as? TintColorFilterParams)?.colorProvider
+    if (dayTint != null) {
+      day.colorFilterParams = TintColorFilterParams(dayNight(dayTint, nightTint))
+    }
+  }
+  if (day is EmittableWithChildren && night is EmittableWithChildren && day.children.size == night.children.size) {
+    day.children.zip(night.children).forEach { (dayChild, nightChild) -> mergeNightColors(dayChild, nightChild) }
+  }
+}
+
+private fun GlanceModifier.withNightColors(night: GlanceModifier): GlanceModifier {
+  val dayElements = foldIn(mutableListOf<GlanceModifier.Element>()) { list, element -> list.apply { add(element) } }
+  val nightElements = night.foldIn(mutableListOf<GlanceModifier.Element>()) { list, element -> list.apply { add(element) } }
+  if (dayElements.size != nightElements.size) {
+    return this
+  }
+  return dayElements.zip(nightElements).fold(GlanceModifier as GlanceModifier) { modifier, (dayElement, nightElement) ->
+    modifier.then(
+      if (dayElement is BackgroundModifier.Color && nightElement is BackgroundModifier.Color) {
+        BackgroundModifier.Color(dayNight(dayElement.colorProvider, nightElement.colorProvider))
+      } else {
+        dayElement
+      }
+    )
+  }
+}
+
+private fun dayNight(day: ColorProvider, night: ColorProvider?): ColorProvider {
+  if (day !is FixedColorProvider || night !is FixedColorProvider || day.color == night.color) {
+    return day
+  }
+  return DayNightColorProvider(day = day.color, night = night.color)
+}
