+/**
+ * A snapshot-state counter per widget. Glance keeps a widget's session (its
+ * composition) alive for a while after an update, and `update()` on a live
+ * session only recomposes content that reads changed state. `provideRoot` reads
+ * nothing Compose can observe (props come from SharedPreferences), so without
+ * this, every update that lands while a session is alive is dropped and the
+ * widget keeps showing the earlier props.
+ */
+internal object WidgetsRevisions {
+  private val revisions = ConcurrentHashMap<String, MutableIntState>()
+
+  /** Call during composition so the widget's content recomposes on [bump]. */
+  fun read(name: String): Int = state(name).intValue
+
+  fun bump(name: String) {
+    Snapshot.withMutableSnapshot {
+      state(name).intValue += 1
+    }
+  }
+
+  private fun state(name: String) = revisions.getOrPut(name) { mutableIntStateOf(0) }
+}
